// 通用函数调用计时宏
#ifdef __CUDACC__
    // FORMAT-WARN: 疑似注释掉的代码，见 format_changes.log
    // GPU计时宏 - 细粒度计时（verbose=1时输出）
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
    #define GPU_TIMER_START() cudaEvent_t start_event_gpu_timer_; cudaEventCreate(&start_event_gpu_timer_); cudaEventRecord(start_event_gpu_timer_)
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
    #define GPU_TIMER_END(name) \
        cudaEvent_t stop_event_gpu_timer_; \
        cudaEventCreate(&stop_event_gpu_timer_); \
        cudaEventRecord(stop_event_gpu_timer_); \
        cudaEventSynchronize(stop_event_gpu_timer_); \
        float gpu_time_ms_; \
        cudaEventElapsedTime(&gpu_time_ms_, start_event_gpu_timer_, stop_event_gpu_timer_); \
        do { if (rtdVerboseFineTiming()) printf("[TIMING] %s execution time: %.3f ms\n", name, gpu_time_ms_); } while(0); \
        cudaEventDestroy(start_event_gpu_timer_); \
        cudaEventDestroy(stop_event_gpu_timer_)

    // FORMAT-WARN: 疑似注释掉的代码，见 format_changes.log
    // GPU计时宏 - 仅总耗时（verbose=2时输出）
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
    #define GPU_TIMER_START_SUMMARY() cudaEvent_t start_event_gpu_timer_summary_; cudaEventCreate(&start_event_gpu_timer_summary_); cudaEventRecord(start_event_gpu_timer_summary_)
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
    #define GPU_TIMER_END_SUMMARY(name) \
        cudaEvent_t stop_event_gpu_timer_summary_; \
        cudaEventCreate(&stop_event_gpu_timer_summary_); \
        cudaEventRecord(stop_event_gpu_timer_summary_); \
        cudaEventSynchronize(stop_event_gpu_timer_summary_); \
        float gpu_time_ms_summary_; \
        cudaEventElapsedTime(&gpu_time_ms_summary_, start_event_gpu_timer_summary_, stop_event_gpu_timer_summary_); \
        do { if (rtdVerboseSummary()) printf("[TIMING] %s total execution time: %.3f ms\n", name, gpu_time_ms_summary_); } while(0); \
        cudaEventDestroy(start_event_gpu_timer_summary_); \
        cudaEventDestroy(stop_event_gpu_timer_summary_)
#else
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
    #define GPU_TIMER_START()
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
    #define GPU_TIMER_END(name)
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
    #define GPU_TIMER_START_SUMMARY()
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
    #define GPU_TIMER_END_SUMMARY(name)
#endif

    // FORMAT-WARN: 疑似注释掉的代码，见 format_changes.log
// CPU计时宏 - 细粒度计时（verbose=1时输出）
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
#define CPU_TIMER_START() auto start_cpu_timer_ = std::chrono::high_resolution_clock::now()
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
#define CPU_TIMER_END(name) \
    auto end_cpu_timer_ = std::chrono::high_resolution_clock::now(); \
    auto duration_cpu_timer_ = std::chrono::duration_cast<std::chrono::milliseconds>(end_cpu_timer_ - start_cpu_timer_); \
    do { if (rtdVerboseFineTiming()) printf("[TIMING] %s execution time: %ld ms (CPU)\n", name, duration_cpu_timer_.count()); } while(0)

    // FORMAT-WARN: 疑似注释掉的代码，见 format_changes.log
// 总耗时计时宏（verbose=2时输出）- 仅输出最终总耗时
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
#define CPU_TIMER_START_SUMMARY() auto start_cpu_timer_summary_ = std::chrono::high_resolution_clock::now()
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
#define CPU_TIMER_END_SUMMARY(name) \
    auto end_cpu_timer_summary_ = std::chrono::high_resolution_clock::now(); \
    auto duration_cpu_timer_summary_ = std::chrono::duration_cast<std::chrono::milliseconds>(end_cpu_timer_summary_ - start_cpu_timer_summary_); \
    do { if (rtdVerboseSummary()) printf("[TIMING] %s total execution time: %ld ms\n", name, duration_cpu_timer_summary_.count()); } while(0)

// 兼容旧的宏名称 - 总是输出（为了向后兼容，改为检查verbose>0）
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
#define CPU_TIMER_END_FORCE(name) \
    { \
        auto end_cpu_timer_force_ = std::chrono::high_resolution_clock::now(); \
        auto duration_cpu_timer_force_ = std::chrono::duration_cast<std::chrono::milliseconds>(end_cpu_timer_force_ - start_cpu_timer_); \
        if (rtdVerboseEnabled()) printf("[TIMING] %s execution time: %ld ms (CPU)\n", name, duration_cpu_timer_force_.count()); \
    }

