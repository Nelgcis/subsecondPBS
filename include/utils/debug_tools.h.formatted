    // FORMAT-WARN: 疑似注释掉的代码，见 format_changes.log
// Get verbose level (0=off, 1=fine timing, 2=summary only)
inline int rtdVerboseLevel() {
    const char* v = std::getenv("RTD_VERBOSE");
    if (!v) return 0;
    const std::string s(v);
    if (s == "0" || s == "false" || s == "FALSE" || s == "off" || s == "OFF") return 0;
    if (s == "2" || s == "summary") return 2;
    // Default to 1 for other truthy values
    return 1;
}

    // FORMAT-WARN: 疑似注释掉的代码，见 format_changes.log
// Legacy: check if any verbose level is enabled (backward compatibility)
inline bool rtdVerboseEnabled() {
    return rtdVerboseLevel() > 0;
}

    // FORMAT-WARN: 疑似注释掉的代码，见 format_changes.log
// Check if fine timing is enabled (verbose level 1)
inline bool rtdVerboseFineTiming() {
    return rtdVerboseLevel() == 1;
}

    // FORMAT-WARN: 疑似注释掉的代码，见 format_changes.log
// Check if summary timing is enabled (verbose level 2)
inline bool rtdVerboseSummary() {
    return rtdVerboseLevel() >= 2;
}

    // FORMAT-WARN: 疑似注释掉的代码，见 format_changes.log
// Set verbose level (0/1/2, or bool for backward compatibility)
inline void setRTDVerbose(int level) {
    std::string val;
    if (level <= 0) val = "0";
    else if (level == 1) val = "1";
    else val = "2";
    setenv("RTD_VERBOSE", val.c_str(), 1);
}

// Overload for backward compatibility with bool
inline void setRTDVerbose(bool enabled) {
    setRTDVerbose(enabled ? 1 : 0);
}

// CUDA错误检查宏
// FORMAT-WARN: 宏函数建议改为 template/inline 函数，见 format_changes.log
#define CUDA_CHECK(call) \
    do { \
        cudaError_t error = (call); \
        if (error != cudaSuccess) { \
            printf("CUDA error at %s:%d - %s\n", __FILE__, __LINE__, cudaGetErrorString(error)); \
            exit(1); \
        } \
    } while(0)

