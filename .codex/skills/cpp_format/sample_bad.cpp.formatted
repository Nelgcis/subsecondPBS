        return myValue;
    }

    void doSomething() {
    // FORMAT-WARN: if/for/while 语句缺少大括号，见 format_changes.log
        if (myValue > 0)
            cout << myValue << endl;  // if 没有大括号

    // FORMAT-WARN: if/for/while 语句缺少大括号，见 format_changes.log
